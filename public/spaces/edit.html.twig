{% extends "layouts/main.html.twig" %}

{% block title %}Editar Cajón de Estacionamiento{% endblock %}

{% block content %}
<div class="container-fluid" style="max-width: 700px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Editar Cajón / Espacio</h2>
      <p class="text-muted mb-0">Modifica las tarifas o características del cajón.</p>
    </div>
    <a href="{{ base_url }}/spaces" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <form method="POST" action="{{ base_url }}/spaces/update/{{ space.id }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Código *</label>
            <input type="text" name="code" class="form-control form-control-sm" value="{{ space.code }}" required>
          </div>
          <div class="col-md-8">
            <label class="form-label fw-bold">Nombre del Cajón *</label>
            <input type="text" name="name" class="form-control form-control-sm" value="{{ space.name }}" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Sección / Zona</label>
          <select name="section_id" class="form-select form-select-sm">
            <option value="">-- Sin Sección Asignada --</option>
            {% for sec in sections %}
              <option value="{{ sec.id }}" {{ space.section_id == sec.id ? 'selected' : '' }}>{{ sec.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Tarifa por Hora ($) *</label>
            <input type="number" step="0.5" name="price_hour" class="form-control form-control-sm" value="{{ space.price_hour }}" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Tarifa por Fracción / 30 Min ($) *</label>
            <input type="number" step="0.5" name="price_half" class="form-control form-control-sm" value="{{ space.price_half }}" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Descripción / Características</label>
          <textarea name="description" class="form-control form-control-sm" rows="3">{{ space.description }}</textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="{{ base_url }}/spaces" class="btn btn-sm btn-light">Cancelar</a>
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-check-lg me-1"></i> Actualizar Cajón
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
