{% extends "layouts/main.html.twig" %}

{% block title %}Editar Ticket de Estacionamiento{% endblock %}

{% block content %}
<div class="container-fluid" style="max-width: 800px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Editar Ticket #{{ rent.id }}</h2>
      <p class="text-muted mb-0">Corrección manual de datos de entrada, salida o tarifa cobrada.</p>
    </div>
    <a href="{{ base_url }}/rents" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <form method="POST" action="{{ base_url }}/rents/update/{{ rent.id }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div class="mb-3">
          <label class="form-label fw-bold">Cajón / Espacio Asignado *</label>
          <select name="space_id" class="form-select form-select-sm" required>
            {% for s in spaces %}
              {% set sec = s.getSection() %}
              <option value="{{ s.id }}" {{ rent.space_id == s.id ? 'selected' : '' }}>
                [{{ s.code }}] {{ s.name }} ({{ sec ? sec.name : 'Sin sección' }})
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Cliente Habitual</label>
            <select name="customer_id" class="form-select form-select-sm">
              <option value="">-- No habitual (usar nombre manual) --</option>
              {% for c in customers %}
                <option value="{{ c.id }}" {{ rent.customer_id == c.id ? 'selected' : '' }}>{{ c.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Nombre Manual (Cliente No Habitual)</label>
            <input type="text" name="person_name" class="form-control form-control-sm" value="{{ rent.person_name }}">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Vehículo Vinculado</label>
          <select name="vehicle_id" class="form-select form-select-sm">
            <option value="">-- Sin vehículo registrado --</option>
            {% for v in vehicles %}
              <option value="{{ v.id }}" {{ rent.vehicle_id == v.id ? 'selected' : '' }}>
                {{ v.plate }} - {{ v.brand }} {{ v.model }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Fecha Entrada</label>
            <input type="date" name="start_date" class="form-control form-control-sm" value="{{ rent.start_date }}" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Hora Entrada</label>
            <input type="time" name="start_time" class="form-control form-control-sm" value="{{ rent.start_time }}" required>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Fecha Salida</label>
            <input type="date" name="finish_date" class="form-control form-control-sm" value="{{ rent.finish_date }}">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Hora Salida</label>
            <input type="time" name="finish_time" class="form-control form-control-sm" value="{{ rent.finish_time }}">
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Minutos de Cortesía</label>
            <input type="number" name="bonus_mins" class="form-control form-control-sm" value="{{ rent.bonus_mins }}">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Monto Total Cobrado ($)</label>
            <input type="number" step="0.5" name="price" class="form-control form-control-sm" value="{{ rent.price }}">
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="{{ base_url }}/rents" class="btn btn-sm btn-light">Cancelar</a>
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-check-lg me-1"></i> Actualizar Ticket
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
