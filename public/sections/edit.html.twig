{% extends "layouts/main.html.twig" %}

{% block title %}Editar Sección{% endblock %}

{% block content %}
<div class="container-fluid" style="max-width: 700px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Editar Sección</h2>
      <p class="text-muted mb-0">Modifica los detalles de la sección.</p>
    </div>
    <a href="{{ base_url }}/sections" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <form method="POST" action="{{ base_url }}/sections/update/{{ section.id }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div class="mb-3">
          <label class="form-label fw-bold">Nombre de la Sección *</label>
          <input type="text" name="name" class="form-control form-control-sm" value="{{ section.name }}" required>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Descripción / Notas</label>
          <textarea name="description" class="form-control form-control-sm" rows="3">{{ section.description }}</textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="{{ base_url }}/sections" class="btn btn-sm btn-light">Cancelar</a>
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-check-lg me-1"></i> Actualizar Sección
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
