{% extends "layouts/main.html.twig" %}

{% block title %}Nueva Sección{% endblock %}

{% block content %}
<div class="container-fluid" style="max-width: 700px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Nueva Sección</h2>
      <p class="text-muted mb-0">Registra un área o nivel del estacionamiento.</p>
    </div>
    <a href="{{ base_url }}/sections" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <form method="POST" action="{{ base_url }}/sections/create">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div class="mb-3">
          <label class="form-label fw-bold">Nombre de la Sección *</label>
          <input type="text" name="name" class="form-control form-control-sm" required placeholder="Ej: Planta Baja, Nivel 1, Zona VIP">
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Descripción / Notas</label>
          <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Detalles de ubicación, accesos, etc."></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="{{ base_url }}/sections" class="btn btn-sm btn-light">Cancelar</a>
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-save me-1"></i> Guardar Sección
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
