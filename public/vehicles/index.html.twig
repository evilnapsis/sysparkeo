{% extends "layouts/main.html.twig" %}

{% block title %}Vehículos Registrados{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Vehículos</h2>
      <p class="text-muted mb-0">Catálogo de autos, motocicletas y placas vinculadas a clientes del estacionamiento.</p>
    </div>
    <a href="{{ base_url }}/vehicles/new" class="btn btn-sm btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Nuevo Vehículo
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white py-3">
      <h6 class="m-0 font-weight-bold text-primary">Listado de Vehículos Registrados</h6>
    </div>
    <div class="card-body p-0">
      {% if vehicles is empty %}
        <div class="text-center py-5 text-muted">
          <i class="bi bi-car-front fs-1 d-block mb-2"></i>
          No hay vehículos registrados en el sistema.
        </div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Placas / Matrícula</th>
                <th>Nombre / Alias</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Propietario / Cliente</th>
                <th>Fecha Registro</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {% for v in vehicles %}
                {% set cust = v.getCustomer() %}
                <tr>
                  <td><span class="badge bg-dark fs-6">{{ v.plate }}</span></td>
                  <td class="fw-bold">{{ v.name ?: '-' }}</td>
                  <td>{{ v.brand ?: '-' }}</td>
                  <td>{{ v.model ?: '-' }}</td>
                  <td>
                    {% if cust %}
                      <a href="{{ base_url }}/customers/edit/{{ cust.id }}" class="text-decoration-none fw-bold">
                        <i class="bi bi-person me-1"></i>{{ cust.name }}
                      </a>
                    {% else %}
                      <span class="text-muted fst-italic">Sin propietario</span>
                    {% endif %}
                  </td>
                  <td><small class="text-muted">{{ v.created_at }}</small></td>
                  <td class="text-end">
                    <a href="{{ base_url }}/vehicles/edit/{{ v.id }}" class="btn btn-xs btn-outline-primary" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <a href="{{ base_url }}/vehicles/delete/{{ v.id }}" class="btn btn-xs btn-outline-danger" title="Eliminar" onclick="return confirm('¿Seguro que deseas eliminar este vehículo?')">
                      <i class="bi bi-trash"></i>
                    </a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
