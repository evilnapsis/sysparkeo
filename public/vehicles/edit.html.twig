{% extends "layouts/main.html.twig" %}

{% block title %}Editar Vehículo{% endblock %}

{% block content %}
<div class="container-fluid" style="max-width: 700px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Editar Vehículo</h2>
      <p class="text-muted mb-0">Actualiza las placas o especificaciones del vehículo.</p>
    </div>
    <a href="{{ base_url }}/vehicles" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <form method="POST" action="{{ base_url }}/vehicles/update/{{ vehicle.id }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Placas / Matrícula *</label>
            <input type="text" name="plate" class="form-control form-control-sm text-uppercase fw-bold" value="{{ vehicle.plate }}" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Nombre / Alias</label>
            <input type="text" name="name" class="form-control form-control-sm" value="{{ vehicle.name }}">
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Marca</label>
            <input type="text" name="brand" class="form-control form-control-sm" value="{{ vehicle.brand }}">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Modelo</label>
            <input type="text" name="model" class="form-control form-control-sm" value="{{ vehicle.model }}">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Cliente / Propietario Habitual</label>
          <select name="customer_id" class="form-select form-select-sm">
            <option value="">-- Sin Cliente Asociado (Público General) --</option>
            {% for c in customers %}
              <option value="{{ c.id }}" {{ vehicle.customer_id == c.id ? 'selected' : '' }}>
                {{ c.name }} ({{ c.phone ?: 'Sin tel.' }})
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="{{ base_url }}/vehicles" class="btn btn-sm btn-light">Cancelar</a>
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-check-lg me-1"></i> Actualizar Vehículo
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
