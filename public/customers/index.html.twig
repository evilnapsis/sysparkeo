{% extends "layouts/main.html.twig" %}

{% block title %}Clientes Habituales / Abonados{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Clientes Habituales</h2>
      <p class="text-muted mb-0">Gestión de abonados, conductores recurrentes y datos de contacto.</p>
    </div>
    <a href="{{ base_url }}/customers/new" class="btn btn-sm btn-primary">
      <i class="bi bi-person-plus me-1"></i> Nuevo Cliente
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white py-3">
      <h6 class="m-0 font-weight-bold text-primary">Directorio de Clientes Habituales</h6>
    </div>
    <div class="card-body p-0">
      {% if customers is empty %}
        <div class="text-center py-5 text-muted">
          <i class="bi bi-people fs-1 d-block mb-2"></i>
          No hay clientes habituales registrados aún.
        </div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th># ID</th>
                <th>Nombre Completo</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Dirección</th>
                <th>Vehículos</th>
                <th>Fecha Registro</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {% for c in customers %}
                <tr>
                  <td>#{{ c.id }}</td>
                  <td class="fw-bold"><i class="bi bi-person-circle text-primary me-2"></i>{{ c.name }}</td>
                  <td>{{ c.phone ?: '-' }}</td>
                  <td>{{ c.email ?: '-' }}</td>
                  <td>{{ c.address ?: '-' }}</td>
                  <td>
                    <span class="badge bg-secondary">{{ c.getVehiclesCount() }} vehículos</span>
                  </td>
                  <td><small class="text-muted">{{ c.created_at }}</small></td>
                  <td class="text-end">
                    <a href="{{ base_url }}/vehicles/new?customer_id={{ c.id }}" class="btn btn-xs btn-outline-success" title="Registrar Vehículo">
                      <i class="bi bi-car-front-fill"></i>
                    </a>
                    <a href="{{ base_url }}/customers/edit/{{ c.id }}" class="btn btn-xs btn-outline-primary" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <a href="{{ base_url }}/customers/delete/{{ c.id }}" class="btn btn-xs btn-outline-danger" title="Eliminar" onclick="return confirm('¿Seguro que deseas eliminar este cliente?')">
                      <i class="bi bi-trash"></i>
                    </a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
